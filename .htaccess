# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/setterho/coachassist.setterholm.se"
PassengerBaseURI "/"
PassengerNodejs "/home/setterho/nodevenv/coachassist.setterholm.se/20/bin/node"
PassengerAppType node
PassengerStartupFile app.cjs
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Enable detailed error messages in browser if application crashes during startup
PassengerFriendlyErrorPages on

# Apache configuration for CoachAssist hosted at root of domain or subdomain
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct /assets/* requests to dist/assets/* if not directly found in root
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 2. Prevent Apache from serving the raw source index.html in the root folder.
  # Instead, rewrite requests for the root '/' or '/index.html' to the compiled '/dist/index.html'.
  RewriteRule ^(index\.html)?$ dist/index.html [L]

  # 3. Direct static file serving:
  # If the requested URL is a real file on disk (like compiled assets, images, etc.), let Apache serve it directly.
  # This serves JS, CSS, images, and other compiled assets instantly without Node.js overhead.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. If an asset, script, or stylesheet was requested but not found, return a 404 immediately
  # (exclude /api/ and /uploads/ so Node.js can dynamically handle API routes and database-backed image recovery)
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteCond %{REQUEST_URI} \.(js|css|mjs|tsx|ts|map|png|jpg|jpeg|svg|ico|webmanifest)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 5. SPA Client-Side Routing Fallback (for non-API and non-uploads routes)
  # When accessing subpages directly, serve dist/index.html so React Router/SPA can render it.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteRule ^ dist/index.html [L]
</IfModule>

