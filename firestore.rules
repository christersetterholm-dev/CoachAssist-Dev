// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: shared_leaderboards
// Document ID: {id}
// Fields:
//   - id: string (required) - Unique ID for the shared leaderboard
//   - name: string (required) - Name of the period
//   - startDate: number (optional) - Start timestamp
//   - endDate: number (optional) - End timestamp
//   - standings: array (required) - List of player standings
//   - createdAt: number (required) - Creation timestamp
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'christer.setterholm@gmail.com' ||
        request.auth.token.email == 'christer@setterholm.se' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSharedLeaderboard(data) {
      return data.keys().hasAll(['id', 'name', 'standings', 'createdAt', 'coachUid']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.standings is list && data.standings.size() <= 200 &&
             data.createdAt is number &&
             data.coachUid is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Hybrid Cloud Server Persistence (REST API calls from server.ts)
    match /app_docs/{docId} {
      allow read, write: if true;
    }

    match /server_users/{email} {
      allow read, write: if true;
    }

    match /server_user_ids/{userId} {
      allow read, write: if true;
    }

    // Admins configuration
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // Clubs global settings, metadata, and members lists
    match /clubs/{clubId}/teams/club_global/data/metadata {
      allow read, write: if isAuthenticated();
    }

    match /clubs/{clubId}/teams/club_global/data/members {
      allow read, write: if isAuthenticated();
    }

    // Club teams granular data segments (squad, sessions, exercises, lineups, periods, settings)
    match /clubs/{clubId}/teams/{teamId}/data/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /shared_leaderboards/{id} {
      // Anyone can read a shared leaderboard if they have the ID
      allow read: if true;
      
      // Allow create / update for all_clubs or valid shared leaderboards
      allow create, update: if id == 'all_clubs' || (
        isAuthenticated() && isValidSharedLeaderboard(request.resource.data)
      );
      
      allow delete: if isAuthenticated() && (isRootAdmin() || resource.data.coachUid == request.auth.uid);
    }

    match /users/{userId}/config/state {
      // Users can read/write their own state, guest state, or root admin
      allow read, write: if userId == 'guest' || (isAuthenticated() && (request.auth.uid == userId || isRootAdmin()));
    }

    match /users/{userId}/data/{docId} {
      // Users can read/write their own data, guest data, or root admin
      allow read, write: if userId == 'guest' || (isAuthenticated() && (request.auth.uid == userId || isRootAdmin()));
    }

    match /users/{userId}/lineup_history/{lineupId} {
      allow read, write: if userId == 'guest' || (isAuthenticated() && (request.auth.uid == userId || isRootAdmin()));
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
