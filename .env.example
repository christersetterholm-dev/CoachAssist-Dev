# Kopiera till .env och fyll i. .env läses automatiskt av servern.
# På webbhotellet kan samma variabler i stället sättas i cPanels Node.js-vy ("Environment variables").

# Hemlig nyckel för inloggningar. Generera med: openssl rand -hex 32
# Utan den skapas en slumpad nyckel som sparas i databasen.
JWT_SECRET=

# Hur länge en inloggning gäller (standard 30d).
JWT_EXPIRES_IN=30d

# Kommaseparerade e-postadresser som är root-administratörer.
ADMIN_EMAILS=christer.setterholm@gmail.com,christer@setterholm.se

# Google-inloggning (valfritt). Client ID från Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# E-post för lösenordsåterställning (valfritt).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
