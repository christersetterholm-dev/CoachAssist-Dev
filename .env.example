# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID for 'Logga in med Google' and account linking.
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# JWT_SECRET: Secret key used to sign and verify authentication JWT sessions.
# In production, ALWAYS generate and set a cryptographically secure random string (e.g. `openssl rand -hex 32`).
# If omitted, the server will automatically generate a unique 256-bit random key on startup.
JWT_SECRET=

# JWT_EXPIRES_IN: Lifetime of authentication tokens (default: 30d).
JWT_EXPIRES_IN=30d

# ADMIN_EMAILS: Comma-separated list of root administrator email addresses permitted to access system configuration, backups, and deployments.
ADMIN_EMAILS=christer.setterholm@gmail.com,christer@setterholm.se
